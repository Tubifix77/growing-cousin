#!/usr/bin/env python3
# tool: tool-replace
# call: tool-replace <name>   stdin, each marker on its own line: <<<<<<< SEARCH / the lines as they are now / ======= / what they should become / >>>>>>> REPLACE  (repeat the block for more passages)
# does: Change PART of one of your tools: each exact passage you quote is replaced, the rest is untouched, a .bak is kept.
"""The creature's partial-edit hand (PLAN item 21.2).

WHY IT EXISTS. `tool-edit` takes the COMPLETE new content on stdin, so changing
one line of a tool costs a reply as long as the whole tool. On 2026-09-20 that
made `plan` -- then 9 KB -- structurally uneditable inside a 3072-token budget:
298 of 346 cut-off replies were whole-tool rewrites. The budget was raised and
the wall moved to ~25 KB; it did not go away, because the idiom is the wall.
A hand that replaces a PASSAGE costs output proportional to the change.

INPUT, on stdin, one or more blocks:

    <<<<<<< SEARCH
    the lines as they are now, exactly
    =======
    what they should become
    >>>>>>> REPLACE

ALL OR NOTHING. Every SEARCH must be found EXACTLY ONCE in the file as it
stands, or nothing is written and the reply says which block and why. A tool
half-changed by a partial edit is worse than one left alone -- the 2026-09-14
fence scar wrote twelve broken files, one cut at a time.

It never guesses. A passage that matches only when indentation is ignored is
refused and located, not "fixed": the creature's source is the creature's, and
a hand that rewrites what it was given is the framework editing `tools/own`
through a side door (CLAUDE.md §2.1).
"""
import os
import re
import stat
import subprocess
import sys
import tempfile

SE = "surrogateescape"
BLOCK = re.compile(
    r"^<{7} SEARCH[ \t]*\n(.*?)^={7}[ \t]*\n(.*?)^>{7} REPLACE[ \t]*$",
    re.S | re.M)


def fail(msg):
    sys.stderr.write(msg.rstrip() + "\n")
    sys.exit(1)


def starts(text, search):
    """Every offset where `search` begins AT THE START OF A LINE.

    A plain substring count was the first version, and its own test caught
    it: `return 'hello'` quoted without its indentation matched the middle
    of `    return 'hello'` and was accepted. Harmless that once; in general
    quoting `x = 1` would match inside `max = 1` and splice the replacement
    into the middle of a line. A passage is whole lines or it is nothing."""
    out, i = [], text.find(search)
    while i >= 0:
        if i == 0 or text[i - 1] == "\n":
            out.append(i)
        i = text.find(search, i + 1)
    return out


def near(text, search):
    """Where the passage WOULD be if indentation were ignored -- to point at,
    never to use."""
    first = next((l.strip() for l in search.splitlines() if l.strip()), "")
    if not first:
        return None
    for i, line in enumerate(text.splitlines(), 1):
        if line.strip() == first:
            return i
    return None


def main():
    name = sys.argv[1] if len(sys.argv) > 1 else ""
    if not name or "/" in name or "\\" in name or name.startswith("."):
        fail("usage: tool-replace <name>, and on stdin one or more blocks:\n"
             "<<<<<<< SEARCH\n(the lines as they are now)\n=======\n"
             "(what they should become)\n>>>>>>> REPLACE")
    mind = os.environ.get("MIND", ".")
    p = os.path.join(mind, "tools", "own", name)
    if not os.path.isfile(p):
        fail("no tool called %s in tools/own -- tool-new makes one, "
             "tool-edit replaces one whole" % name)
    # Bytes, whatever the host's codec -- see tool-edit, 2026-09-24.
    raw = (sys.stdin.buffer.read().decode("utf-8", SE)
           .replace("\r\n", "\n").replace("\r", "\n"))
    blocks = BLOCK.findall(raw)
    if not blocks:
        fail("no SEARCH/REPLACE block on stdin. Each block is:\n"
             "<<<<<<< SEARCH\n(the lines as they are now)\n=======\n"
             "(what they should become)\n>>>>>>> REPLACE")
    # surrogateescape, never "replace": a stray byte elsewhere in the tool
    # must come back out exactly as it went in, not as U+FFFD.
    with open(p, encoding="utf-8", errors=SE, newline="") as f:
        old = f.read()
    # A passage quoted from the LAST line of a file with no final newline
    # ends in one anyway, because every block line does. Match against the
    # file as if it had one, and give it back as it was.
    bare_end = bool(old) and not old.endswith("\n")
    new = old + ("\n" if bare_end else "")
    for n, (search, replace) in enumerate(blocks, 1):
        if not search.strip():
            fail("block %d has an empty SEARCH: say what to replace, or use "
                 "tool-edit to write the whole file" % n)
        at_line = starts(new, search)
        hits = len(at_line)
        if hits == 0:
            at = near(new, search)
            fail("block %d: that passage is not in %s as it stands%s. Nothing "
                 "was written. Copy the lines exactly, indentation included."
                 % (n, name, (" (its first line appears at line %d with "
                              "different spacing)" % at) if at else ""))
        if hits > 1:
            fail("block %d: that passage appears %d times in %s, so which one "
                 "is meant is not clear. Nothing was written. Quote a few more "
                 "lines around the one you mean." % (n, hits, name))
        i = at_line[0]
        new = new[:i] + replace + new[i + len(search):]
    if bare_end and new.endswith("\n"):
        new = new[:-1]
    if new == old:
        fail("the blocks change nothing; %s left as it was" % name)
    with open(p + ".bak", "w", encoding="utf-8", errors=SE, newline="") as f:
        f.write(old)                                     # never edit without a .bak
    tmp = p + ".tmp"
    with open(tmp, "w", encoding="utf-8", errors=SE, newline="") as f:
        f.write(new)
    os.replace(tmp, p)
    os.chmod(p, os.stat(p).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    print("replaced %d passage(s) in tools/own/%s (%d -> %d lines)"
          % (len(blocks), name, len(old.splitlines()), len(new.splitlines())))
    # A WARNING, never a refusal, exactly as tool-edit: saved as given, exit 0.
    first = new.splitlines()[0] if new.splitlines() else ""
    if "python" in first:
        t = tempfile.NamedTemporaryFile("w", suffix=".py", delete=False,
                                        encoding="utf-8", errors=SE, newline="")
        t.write(new)
        t.close()
        r = subprocess.run([sys.executable, "-m", "py_compile", t.name],
                           capture_output=True, text=True)
        os.unlink(t.name)
        if r.returncode != 0:
            sys.stderr.write("WARNING: %s cannot start now: %s\n"
                             % (name, (r.stderr or "").strip().splitlines()[-1:]))
    elif first.startswith("#!") and ("sh" in first):
        r = subprocess.run(["bash", "-n", p], capture_output=True, text=True)
        if r.returncode != 0:
            sys.stderr.write("WARNING: %s cannot start now: %s\n"
                             % (name, (r.stderr or "").strip()[:200]))


if __name__ == "__main__":
    main()
