#!/usr/bin/env python3
# tool: remember
# call: remember <key> <value>
# does: Write one durable key/value into /mind/state/memory.json.
import json, os, sys
KEY = sys.argv[1] if len(sys.argv) > 1 else ""
VAL = " ".join(sys.argv[2:]) if len(sys.argv) > 2 else ""
if not KEY:
    sys.stderr.write("usage: remember <key> <value>\n"); sys.exit(1)
mind = os.environ.get("MIND", ".")
p = os.path.join(mind, "state", "memory.json")
os.makedirs(os.path.dirname(p), exist_ok=True)
try:
    d = json.load(open(p, encoding="utf-8"))
except Exception:
    d = {}
d[KEY] = VAL
tmp = p + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    json.dump(d, f, indent=2)
os.replace(tmp, p)          # tmp+replace: a crash mid-write must not corrupt it
print("remembered %s = %s" % (KEY, VAL))
