#!/usr/bin/env python3
# tool: tool-new
# call: tool-new <name>
# does: Create an executable tool in tools/own/ carrying the header contract.
import os, stat, sys
name = sys.argv[1] if len(sys.argv) > 1 else ""
if not name:
    sys.stderr.write("usage: tool-new <name>\n"); sys.exit(1)
mind = os.environ.get("MIND", ".")
d = os.path.join(mind, "tools", "own")
os.makedirs(d, exist_ok=True)
p = os.path.join(d, name)
if os.path.exists(p):
    sys.stderr.write("%s already exists -- use tool-edit\n" % name); sys.exit(1)
# The header is written WITH the '#' because a contract shown imprecisely gets
# obeyed literally: the parent lost two months to files that died on line 1.
open(p, "w", encoding="utf-8").write(
    "#!/usr/bin/env python3\n"
    "# tool: %s\n# call: %s\n# does: TODO\n\n"
    'print("%s: not written yet")\n' % (name, name, name))
os.chmod(p, os.stat(p).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
print("created tools/own/%s (a placeholder -- write it before marking done)" % name)
