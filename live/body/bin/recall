#!/usr/bin/env python3
# tool: recall
# call: recall [key]
# does: Read back what was remembered; with no key, list every key held.
import json, os, sys
mind = os.environ.get("MIND", ".")
p = os.path.join(mind, "state", "memory.json")
try:
    d = json.load(open(p, encoding="utf-8"))
except Exception:
    d = {}
if len(sys.argv) > 1:
    k = sys.argv[1]
    if k in d:
        print(d[k])
    else:
        # Absent is not an error, and must not look like one: an empty recall
        # that exits non-zero teaches the creature its memory is broken.
        print("(nothing remembered under %s)" % k)
else:
    if not d:
        print("(memory is empty)")
    for k in sorted(d):
        print("%s = %s" % (k, d[k]))
