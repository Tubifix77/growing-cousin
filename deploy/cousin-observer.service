[Unit]
# The window. It never writes the engine's data and holds no state of its own.
# Its one control is the STOP file: the Start/Stop button, and since 2026-09-26
# CLOSING the window, which asks the engine to stop after its current cycle
# (Tue). Killing the window does not; only a close asks.
Description=Growing Cousin observer (GUI)
After=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
WorkingDirectory=%h/growing-cousin
ExecStart=/usr/bin/python3 %h/growing-cousin/observer.py %h/growing-cousin/live
Restart=on-failure
RestartSec=3

# A window has no business writing anything.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

# NO [Install] SECTION since 2026-09-26 (Tue: nothing of Growing Cousin starts
# unless he starts it). Open the window from the "Growing Cousin" launcher.
