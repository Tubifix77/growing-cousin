[Unit]
# The engine loop. Separate unit, separate WorkingDirectory, separate journal
# from the spine's -- CLAUDE.md §2.6: they share the box and nothing else.
Description=Growing Cousin engine (creature + cousin loop)
After=network-online.target
Wants=network-online.target

# THE BOUND THAT MAKES RESTARTING SAFE, and it lives in [Unit] -- NOT [Service].
# systemd moved these here; left in [Service] they are silently ignored and the
# effective window falls back to the default. Verified 2026-09-13 by reading
# them back off the running unit: `StartLimitIntervalUSec=10s` while the file
# said 1800. The first version of the test only asserted the strings appeared
# somewhere in the file, which is a checker that cannot distinguish the thing
# it measures -- it passed over a setting that did nothing.
#
# At most 5 starts in 30 minutes, then the unit is left in `failed` for real,
# which `systemctl status` reports plainly. Restart, but a bounded number of
# times, answers both failure modes at once: an engine that gives up at 03:00
# comes back, and a persistent fault stops respawning into a free tier the
# spine also pays for.
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/growing-cousin
# StandardOutput=append: cannot CREATE the directory it writes into, so a run
# started from a clean slate dies with 209/STDOUT before reaching any Python --
# no log, and the log is the first thing anyone reads. Found 2026-09-13 by
# archiving live/ for a reset, which is exactly when it would bite.
ExecStartPre=/bin/mkdir -p %h/growing-cousin/live
# The creature's body is a CONTAINER as of 2026-09-16 (PLAN item 7). Building
# on every start is cheap when cached and means the image cannot go missing
# without the engine noticing; `-` so a transient build failure warns rather
# than blocking a start, since the container from the previous build is
# usually still perfectly good.
#
# Verified by effect before this shipped: `PrivateUsers=yes` does NOT block
# access to the docker socket -- tested in a throwaway unit carrying the same
# directives, because a directive read back off a unit proves it was parsed
# and never that it works.
#
# DOCKER_CONFIG must point somewhere WRITABLE or the build can never succeed:
# buildx stamps an activity file under it, and `ProtectHome=read-only` makes
# the default `~/.docker` unwritable. Observed on the first container start --
# `failed to update builder last activity time: read-only file system` -- and
# the `-` prefix meant the engine came up happily on the previous image while
# the build had become a line that could never work. A step that always fails
# silently is worse than no step.
Environment=DOCKER_CONFIG=%h/growing-cousin/live/.docker
ExecStartPre=-/usr/bin/docker build -t growing-cousin-body \
    -f %h/growing-cousin/deploy/Dockerfile %h/growing-cousin/deploy
# --cycles 0 means no ceiling. Stop it with `touch %h/growing-cousin/live/STOP`,
# which lets the current cycle finish; `systemctl stop` kills mid-cycle and
# throws that cycle away.
# -u is not optional: without it Python buffers stdout when it is a file, and
# an unattended run's log stays EMPTY for hours while the engine works fine.
# The first thing anyone does when a night looks wrong is read that log.
ExecStart=/usr/bin/python3 -u %h/growing-cousin/run.py \
    --forever --cycles 0 --pause 30 \
    --root %h/growing-cousin/live \
    --body docker \
    --cousin-shell \
    --rungs %h/growing-cousin/rungs.local.json \
    --cousin-rungs %h/growing-cousin/rungs.cousin.local.json

# on-failure only, NEVER always: a stop that restarts itself is not a stop.
#
# CORRECTED 2026-09-13. This comment used to say the loop "exits 0 when it was
# asked to stop AND when a run of failures ended it", and treated that as
# desirable. It was not: those are opposite events. Being asked to stop is the
# loop finishing its job; giving up after five consecutive failures, or after
# 600 waits with no rung, is the loop ABANDONING it. Both exited 0, so
# on-failure never fired, and the engine could quit at 03:00 and lie there
# reporting success until a human happened to look. On a ten-minute check that
# costs ten minutes. On a daily check it costs the night and the data.
#
# `run.py` now exits 5 when the supervisor gave up, and 0 when it was stopped
# or reached its ceiling.
Restart=on-failure
RestartSec=60
# EXIT 4 IS A REFUSAL, NOT A FAILURE, AND CONFLATING THEM COST A MORNING.
#
# `run.py` exits 4 for exactly one reason: the STOP file exists, so it will
# not start. That is the engine OBEYING -- "a restart must never silently
# undo a deliberate stop" is the whole point of the file.
#
# 2026-09-24, found by Tue on a reboot: a STOP file left from the evening
# survived into the next boot, as it is designed to. The engine refused. But
# `Restart=on-failure` saw exit 4 as a crash and retried it FIVE times, which
# is the entire StartLimitBurst -- so systemd then refused every further start
# with "Start request repeated too quickly", including the observer's own
# Start button, which is the documented way back in. **A deliberate stop did
# not merely stop the engine; it disabled the recovery path**, and the error
# the operator was shown named a rate limit rather than a STOP file.
#
# `SuccessExitStatus=4` is the same move this project already made for the
# monitor on 2026-09-15 (`SuccessExitStatus=1`), for the same reason: a unit's
# FAILURE must not share a channel with the thing it is reporting. With it,
# a refusal leaves the unit `inactive` and untouched by the rate limiter, and
# `systemctl --user --failed` naming cousin-engine means a real fault again.
SuccessExitStatus=4
# The bound on how often this may happen is StartLimit* in [Unit] above.

# PrivateUsers=yes IS LOAD-BEARING, and everything below it was decoration
# without it. Verified 2026-09-13 on this laptop, by testing the EFFECT rather
# than reading the directive back: a throwaway user unit carrying
# ProtectSystem=strict + ProtectHome=read-only + ReadWritePaths WROTE A FILE
# INTO $HOME. All of this file's filesystem sandboxing had been inert since it
# was written, so the creature's bash -- generated by free-tier third-party
# models -- could read AND write anywhere this user can, including
# %h/growing-spine, which CLAUDE.md §2.6 makes a hard boundary.
#
# With PrivateUsers=yes the same probe is blocked and the spine is hidden,
# while the engine keeps exactly what it needs: writes live/, reads its key
# files, reads the repo, reaches both providers. Each of those six was checked
# before this shipped, because a sandbox that breaks the run would be found at
# 03:00 by nobody.
#
# This is the second setting in one evening that was present, live, and doing
# nothing -- after StartLimit* in the wrong section. A directive read back off
# the unit proves it was PARSED, never that it WORKS.
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/growing-cousin/live

# READ-ONLY IS NOT UNREACHABLE, and the comment above used to claim it was.
# 2026-09-13, verified on this laptop: a creature-style command listed
# %h/growing-spine and could read its config.yaml. `ProtectHome=read-only`
# stops the engine WRITING to the sibling; the boundary in CLAUDE.md §2.6 is
# about not touching it at all, and reading its secrets is not "not touching".
# The engine has never needed this path, so making it invisible costs nothing.
InaccessiblePaths=%h/growing-spine

# THE KEY FILES ARE NOW CLOSED, and it took the body the design named from
# the start. Until 2026-09-16 this comment said they were not: the engine
# reads them per call and shared a uid with the shell it spawned, so
# `InaccessiblePaths=%h/keys` would have blinded the engine too, and
# `child_env`'s allow-list closed only the VARIABLES.
#
# With `--body docker` the creature's shell is not on this host at all. Its
# world is a bind mount of live/body/mind and nothing else; `~/keys`, `~`, the
# sibling project and this repo are simply not in its filesystem. Proven by
# effect from inside the body before the switch (`rehearse.py docker`, whose
# evidence the gate asserts) and re-proven at every start by `selfcheck`,
# which now carries `keys_unreadable` -- so the day this regresses, the page
# says so instead of a comment claiming otherwise for three months.
PrivateTmp=true
NoNewPrivileges=true

StandardOutput=append:%h/growing-cousin/live/engine.log
StandardError=append:%h/growing-cousin/live/engine.log

# NO [Install] SECTION, ON PURPOSE (Tue, 2026-09-26): *"so it only starts on
# me actually starting it manually ... no rogue backend run."* Without one,
# `systemctl --user enable` has nothing to hook into, so no boot, login or
# reinstall can start the engine. It starts only when started: the observer's
# Start button, or `systemctl --user start cousin-engine`. Restart=on-failure
# still restarts a run someone started, within the StartLimit bound.
