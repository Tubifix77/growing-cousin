[Unit]
# The engine loop. Separate unit, separate WorkingDirectory, separate journal
# from the spine's -- CLAUDE.md §2.6: they share the box and nothing else.
Description=Growing Cousin engine (creature + cousin loop)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/growing-cousin
# StandardOutput=append: cannot CREATE the directory it writes into, so a run
# started from a clean slate dies with 209/STDOUT before reaching any Python --
# no log, and the log is the first thing anyone reads. Found 2026-09-13 by
# archiving live/ for a reset, which is exactly when it would bite.
ExecStartPre=/bin/mkdir -p %h/growing-cousin/live
# --cycles 0 means no ceiling. Stop it with `touch %h/growing-cousin/live/STOP`,
# which lets the current cycle finish; `systemctl stop` kills mid-cycle and
# throws that cycle away.
# -u is not optional: without it Python buffers stdout when it is a file, and
# an unattended run's log stays EMPTY for hours while the engine works fine.
# The first thing anyone does when a night looks wrong is read that log.
ExecStart=/usr/bin/python3 -u %h/growing-cousin/run.py \
    --forever --cycles 0 --pause 30 \
    --root %h/growing-cousin/live \
    --rungs %h/growing-cousin/rungs.local.json \
    --cousin-rungs %h/growing-cousin/rungs.cousin.local.json

# on-failure only, NEVER always: a stop that restarts itself is not a stop.
#
# CORRECTED 2026-09-13. This comment used to say the loop "exits 0 when it was
# asked to stop AND when a run of failures ended it", and treated that as
# desirable. It was not: those are opposite events. Being asked to stop is the
# loop finishing its job; giving up after five consecutive failures, or after
# 600 waits with no rung, is the loop ABANDONING it. Both exited 0, so
# on-failure never fired, and the engine could quit at 03:00 and lie there
# reporting success until a human happened to look. On a ten-minute check that
# costs ten minutes. On a daily check it costs the night and the data.
#
# `run.py` now exits 5 when the supervisor gave up, and 0 when it was stopped
# or reached its ceiling.
Restart=on-failure
RestartSec=60

# THE BOUND THAT MAKES RESTARTING SAFE. Exiting non-zero would otherwise
# reintroduce exactly what exiting 0 was guarding against -- a persistent fault
# respawning forever, burning free-tier quota the spine also pays for. systemd
# bounds it instead of us: at most 5 starts in 30 minutes, then the unit is
# left in `failed` for real, which is a state `systemctl status` reports
# plainly. Restart, but a bounded number of times, is the answer to both
# failure modes at once.
StartLimitIntervalSec=1800
StartLimitBurst=5

# The engine must not be able to reach the spine's directory. Read-only root
# with an explicit writable carve-out is cheap insurance against a bug in our
# own code doing what the boundary forbids.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/growing-cousin/live
PrivateTmp=true
NoNewPrivileges=true

StandardOutput=append:%h/growing-cousin/live/engine.log
StandardError=append:%h/growing-cousin/live/engine.log

[Install]
WantedBy=default.target
